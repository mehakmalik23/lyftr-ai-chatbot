# Comma-separated pool of at least 2 API keys (mapped to key_1, key_2, ...)
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# LiteLLM model identifier
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite file location inside the mounted Docker volume
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Enable X-Simulate-Failure test hook
ENABLE_FAILURE_SIMULATION=true

# Frontend build-time backend URL
VITE_API_BASE_URL=http://localhost:8000
